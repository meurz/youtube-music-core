<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WinUI uses the Windows App SDK's WinRT WebView2 projection. -->
    <WebView2EnableCsWinRTProjection Condition="'$(WebView2EnableCsWinRTProjection)' == ''">true</WebView2EnableCsWinRTProjection>
    <DefineConstants Condition="'$(WebView2EnableCsWinRTProjection)' == 'true'">$(DefineConstants);WEBVIEW2_WINRT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <ProjectReference Include="../YouTubeMusic.Interop.csproj" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebViewUiReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(WebView2EnableCsWinRTProjection)' != 'true'">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" /></ItemGroup>
  </Target>
</Project>
